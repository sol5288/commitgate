{
  "name": "commitgate",
  "version": "0.23.1",
  "description": "CommitGate — Builder↔Reviewer(Claude↔Codex) fail-closed 커밋 게이트: 리뷰·승인·증거 없인 커밋을 통과시키지 않는 AI REQ 워크플로 kit. 커밋 게이트(req:new/next/review-codex/doctor/commit) + 범위 증거 검증·통합 seam(verify-range/attest/integrate). GitHub CI는 기본 실행하지 않는 opt-in입니다.",
  "type": "module",
  "license": "MIT",
  "author": "sol5288",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sol5288/commitgate.git"
  },
  "homepage": "https://github.com/sol5288/commitgate#readme",
  "bugs": {
    "url": "https://github.com/sol5288/commitgate/issues"
  },
  "keywords": [
    "ai",
    "code-review",
    "workflow",
    "codex",
    "claude",
    "git",
    "commit-gate",
    "fail-closed",
    "review-gate",
    "cli"
  ],
  "bin": {
    "commitgate": "bin/commitgate.mjs"
  },
  "scripts": {
    "req:new": "tsx scripts/req/req-new.ts",
    "req:review-codex": "tsx scripts/req/review-codex.ts",
    "req:doctor": "tsx scripts/req/req-doctor.ts",
    "req:next": "tsx scripts/req/req-next.ts",
    "req:commit": "tsx scripts/req/req-commit.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs",
    "verify:overrides": "node scripts/verify-review-overrides.mjs",
    "docs:lint": "remark docs README.md README.en.md --quiet --frail",
    "test:fast": "vitest run --project fast",
    "test:integration": "vitest run --project integration",
    "req:reconstruct": "tsx scripts/req/req-reconstruct.ts",
    "req:close": "tsx scripts/req/req-close.ts",
    "req:review-exception": "tsx scripts/req/req-review-exception.ts",
    "req:rebind": "tsx scripts/req/req-rebind.ts",
    "req:confirm": "tsx scripts/req/req-confirm.ts",
    "req:repolicy": "tsx scripts/req/req-repolicy.ts",
    "req:delegate": "tsx scripts/req/req-delegate.ts"
  },
  "files": [
    "scripts/req",
    "scripts/verify-review-overrides.mjs",
    "workflow/machine.schema.json",
    "workflow/req.config.schema.json",
    "workflow/review-persona.md",
    "bin",
    "templates",
    "skills",
    "AGENTS.template.md",
    "req.config.json.sample",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "cross-spawn": "^7.0.6",
    "semver": "^7.6.3",
    "tsx": "^4.19.1"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^22.7.4",
    "@types/semver": "^7.5.8",
    "mdast-util-from-markdown": "^2.0.3",
    "remark-cli": "^12.0.1",
    "remark-validate-links": "^13.1.0",
    "typescript": "^5.6.2",
    "unist-util-visit": "^5.1.0",
    "vitest": "^2.1.2"
  }
}
